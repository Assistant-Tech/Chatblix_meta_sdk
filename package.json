{
  "name": "@chatblix/meta-sdk",
  "version": "0.2.4",
  "description": "NestJS SDK module for Meta (Facebook + Instagram) Graph API",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write src tests",
    "typecheck": "tsc --noEmit",
    "prepare": "husky || true",
    "prerelease": "npm run lint && npm run typecheck && npm test && npm run build",
    "release:patch": "npm run prerelease && npm version patch -m \"chore(release): %s\"",
    "release:minor": "npm run prerelease && npm version minor -m \"chore(release): %s\"",
    "release:major": "npm run prerelease && npm version major -m \"chore(release): %s\"",
    "postversion": "git push && git push --tags && npm publish --access public"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/common": "^11.1.13",
    "@nestjs/core": "^11.1.13",
    "@nestjs/testing": "^11.1.13",
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^8.57.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "msw": "^2.14.2",
    "prettier": "^3.8.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18.17"
  }
}
